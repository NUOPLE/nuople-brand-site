{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx tsc -p tsconfig.vercel.json && npx vite build --config vite.standalone.config.ts",
  "outputDirectory": "dist/client",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...slug]" },
    {
      "source": "/((?!assets/|favicon/|favicon\\.ico|robots\\.txt|static/|.*\\.png$|.*\\.jpg$|.*\\.jpeg$|.*\\.svg$|.*\\.webp$|.*\\.gif$|.*\\.ico$).*)",
      "destination": "/index.html"
    }
  ]
}
